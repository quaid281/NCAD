\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Horizon scaling, operating frontier, and archive calibration-size effects. \textbf  {(a)}\nobreakspace  {}Exploratory horizon sweep ($S \in \{1..64\}$, causal lag $S{-}1$, $n{=}5$ streams, nominal FPR $\le 3.6\%$ vs.\ $2.5\%\to 21.3\%$ for TimesNet). \textbf  {(b)}\nobreakspace  {}Design-stage causal ER vs.\ realized test FPR ($\sqrt  {\cdot }$ scale, $n{=}19$ streams) across diagnostic budgets $f^*\in \{1\%,5\%\}$ (dotted), autonomous points, and $q^*{\le }0.05$. \textbf  {(c)}\nobreakspace  {}Primary archive calibration windows $N_{\text  {cal}}$ vs.\ causal held-out $\text  {FPR}_{\text  {hold}}$ across $n{=}118$ untouched streams (Spearman $\rho {=}-0.11$, $p{=}0.22$), marking $N_{\text  {cal}}{=}500$ and $1\%/5\%$ budgets.}}{10}{figure.3}\protected@file@percent }
\newlabel{fig:operating_and_horizon}{{3}{10}{Horizon scaling, operating frontier, and archive calibration-size effects. \textbf {(a)}~Exploratory horizon sweep ($S \in \{1..64\}$, causal lag $S{-}1$, $n{=}5$ streams, nominal FPR $\le 3.6\%$ vs.\ $2.5\%\to 21.3\%$ for TimesNet). \textbf {(b)}~Design-stage causal ER vs.\ realized test FPR ($\sqrt {\cdot }$ scale, $n{=}19$ streams) across diagnostic budgets $f^*\in \{1\%,5\%\}$ (dotted), autonomous points, and $q^*{\le }0.05$. \textbf {(c)}~Primary archive calibration windows $N_{\text {cal}}$ vs.\ causal held-out $\text {FPR}_{\text {hold}}$ across $n{=}118$ untouched streams (Spearman $\rho {=}-0.11$, $p{=}0.22$), marking $N_{\text {cal}}{=}500$ and $1\%/5\%$ budgets}{figure.3}{}}
