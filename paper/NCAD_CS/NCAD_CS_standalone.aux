\citation{koopman1931hamiltonian,mezic2005spectral}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Four-stage \texttt  {Reynolds-Stress JEPA} architecture. (1)\nobreakspace  {}Multiscale windowing splits telemetry at index $t$ into context ($\mathbf  {x}_{\text  {ctx}} \in \mathbb  {R}^{256 \times K}$) and target ($\mathbf  {x}_{\text  {tgt}} \in \mathbb  {R}^{64 \times K}$) blocks processed by a 4-shell dyadic real fast Fourier transform (rFFT) front-end and causal dilated temporal convolutional network (TCN). (2)\nobreakspace  {}Dual online ($E_\theta $) and exponential moving average (EMA) target ($E_\phi $) encoders map windows into $\mathbb  {R}^{32}$. (3)\nobreakspace  {}Reynolds-stress closure forecasts first-moment transport ($\hat  {\mathbf  {z}}_{\text  {tgt}}$) via a Crouzeix dissipative predictor ($w(\mathbf  {W}) \le 1$) and second-moment subgrid covariance ($\bm  {\Sigma }_{\text  {pred}}, \bm  {\Sigma }_{\text  {obs}} \in \mathcal  {S}_+^{d_s}$) on a Stiefel frame $\mathbf  {V} \in \mathrm  {St}(d_s, 32)$. (4)\nobreakspace  {}Parsimonious two-term training objective and saliency-gated SPOT calibration under causal trailing ($\tau = t + 63$) and buffered smear mappings.}}{4}{figure.1}\protected@file@percent }
\newlabel{fig:triad_architecture}{{1}{4}{Four-stage \texttt {Reynolds-Stress JEPA} architecture. (1)~Multiscale windowing splits telemetry at index $t$ into context ($\mathbf {x}_{\text {ctx}} \in \mathbb {R}^{256 \times K}$) and target ($\mathbf {x}_{\text {tgt}} \in \mathbb {R}^{64 \times K}$) blocks processed by a 4-shell dyadic real fast Fourier transform (rFFT) front-end and causal dilated temporal convolutional network (TCN). (2)~Dual online ($E_\theta $) and exponential moving average (EMA) target ($E_\phi $) encoders map windows into $\mathbb {R}^{32}$. (3)~Reynolds-stress closure forecasts first-moment transport ($\hat {\mathbf {z}}_{\text {tgt}}$) via a Crouzeix dissipative predictor ($w(\mathbf {W}) \le 1$) and second-moment subgrid covariance ($\boldsymbol {\Sigma }_{\text {pred}}, \boldsymbol {\Sigma }_{\text {obs}} \in \mathcal {S}_+^{d_s}$) on a Stiefel frame $\mathbf {V} \in \mathrm {St}(d_s, 32)$. (4)~Parsimonious two-term training objective and saliency-gated SPOT calibration under causal trailing ($\tau = t + 63$) and buffered smear mappings}{figure.1}{}}
