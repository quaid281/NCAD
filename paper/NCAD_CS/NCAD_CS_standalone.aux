\newlabel{tab:ablations}{{I}{9}{Ablation studies. (a) Matched-capacity regularizer controls on fixed backbones, 19 non-GHL streams (Point-F1 = stream-macro mean $\pm $ seed SD; held-out FPR on unseen nominal data). (b) Dyadic-shell front-end on/off under identical TS-JEPA configuration across five multivariate exploratory streams (including diagnostic streams SMD and GECCO). Auxiliary input-channel gating and fault-type recall panels are in Supplementary Section~\ref {sup:gating}}{table.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {II}{\ignorespaces Held-out calibration benchmark, 33 telemetry streams (7 domains). Thresholds: SPOT ($q{=}10^{-3}$) on held-out nominal splits. Metrics: held-out nominal FPR (on data the threshold never saw), unadjusted Point-F1, PR-AUC, Event Recall, mean detection delay $\Delta t$ (averaged strictly over detected anomaly events with $\text  {Event Recall} > 0$; scores emitted upon target window completion $\tau = t + S - 1$, $S=64$). ``Non-GHL'': stream-macro over 19 streams at five seeds; ``GHL'': 14 streams at three-to-five seeds; ``Dataset-Macro'': unweighted mean of the 7 dataset means. Best in \textbf  {bold}, second \underline  {underlined}.}}{9}{table.2}\protected@file@percent }
\newlabel{tab:core_benchmark}{{II}{9}{Held-out calibration benchmark, 33 telemetry streams (7 domains). Thresholds: SPOT ($q{=}10^{-3}$) on held-out nominal splits. Metrics: held-out nominal FPR (on data the threshold never saw), unadjusted Point-F1, PR-AUC, Event Recall, mean detection delay $\Delta t$ (averaged strictly over detected anomaly events with $\text {Event Recall} > 0$; scores emitted upon target window completion $\tau = t + S - 1$, $S=64$). ``Non-GHL'': stream-macro over 19 streams at five seeds; ``GHL'': 14 streams at three-to-five seeds; ``Dataset-Macro'': unweighted mean of the 7 dataset means. Best in \textbf {bold}, second \underline {underlined}}{table.2}{}}
