\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {(a)}\nobreakspace  {}Sliding window partitioning of $\mathbf  {X} \in \mathbb  {R}^{T \times K}$ into context $\mathbf  {x}_{\text  {ctx}}$ ($C{=}256$) and suspect target $\mathbf  {x}_{\text  {tgt}}$ ($S{=}64$, decision step $\tau = t + S - 1$). \textbf  {(b)}\nobreakspace  {}Empirical 2D latent projection ($\mathbb  {R}^{32} \to \mathbb  {R}^2$, SMAP \texttt  {E-1}) centered at $\hat  {z}_{\text  {tgt}} = \mathbf  {K}z_{\text  {ctx}}$: nominal calibration ($z_{\text  {tgt}}^{\text  {cal}}$) and held-out ($z_{\text  {tgt}}^{\text  {hold}}$) clouds remain inside $\tau _{\text  {SPOT}}$, whereas fault state $z_{\text  {tgt}}(t)$ crosses $\tau _{\text  {SPOT}}$ along $\mathbf  {e}(t) = z_{\text  {tgt}} - \hat  {z}_{\text  {tgt}}$.}}{4}{figure.2}\protected@file@percent }
