\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Operational latency, score emission, and deployable operating trade-offs. \textbf  {(a)}\nobreakspace  {}Held-out false-positive rate across target horizon lengths $S \in \{1, 4, 16, 32, 64\}$ (score-emission lag $S{-}1 \in \{0, 3, 15, 31, 63\}$ steps, five streams): TimesNet false alarms explode nine-fold ($2.5\% \to 21.3\%$), while TS-JEPA and OpEntropy JEPA remain stable under $2\%$. At $S{=}1$ (zero emission lag), OpEntropy JEPA cuts detection delay to $\Delta t = 76.3$ steps. \textbf  {(b)}\nobreakspace  {}Deployable operating trade-offs at nominal calibration quantiles $q^* \in \{0.001, 0.050\}$ across 19 non-GHL streams (directed arrows indicate $q^*{=}0.001 \to 0.050$): latent predictors define a superior Pareto frontier, achieving higher causal event recall ($0.730\text  {--}0.752$) at substantially fewer nuisance false alarms ($177\text  {--}203$) than TimesNet and TranAD ($262\text  {--}270$).}}{12}{figure.5}\protected@file@percent }
\newlabel{fig:operating_and_horizon}{{5}{12}{Operational latency, score emission, and deployable operating trade-offs. \textbf {(a)}~Held-out false-positive rate across target horizon lengths $S \in \{1, 4, 16, 32, 64\}$ (score-emission lag $S{-}1 \in \{0, 3, 15, 31, 63\}$ steps, five streams): TimesNet false alarms explode nine-fold ($2.5\% \to 21.3\%$), while TS-JEPA and OpEntropy JEPA remain stable under $2\%$. At $S{=}1$ (zero emission lag), OpEntropy JEPA cuts detection delay to $\Delta t = 76.3$ steps. \textbf {(b)}~Deployable operating trade-offs at nominal calibration quantiles $q^* \in \{0.001, 0.050\}$ across 19 non-GHL streams (directed arrows indicate $q^*{=}0.001 \to 0.050$): latent predictors define a superior Pareto frontier, achieving higher causal event recall ($0.730\text {--}0.752$) at substantially fewer nuisance false alarms ($177\text {--}203$) than TimesNet and TranAD ($262\text {--}270$)}{figure.5}{}}
