\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Operator-Entropy JEPA architecture: multiscale context ($\mathbf  {x}_{\text  {ctx}} \in \mathbb  {R}^{256 \times K}$) and suspect ($\mathbf  {x}_{\text  {tgt}} \in \mathbb  {R}^{64 \times K}$) windows are mapped into latent space via online ($E_\theta $) and EMA momentum ($E_\phi $) encoders with a stop-gradient barrier ($\perp $). A linear Koopman transition operator ($\mathbf  {K} \in \mathbb  {R}^{32 \times 32}$) forecasts the target representation $\hat  {\mathbf  {z}}_{\text  {tgt}} = \mathbf  {K}\mathbf  {z}_{\text  {ctx}}$, regularized by dual Von Neumann spectral entropy and a logarithmic Bregman energy barrier against collapse. Residual discrepancies pass through a coordinate saliency gate to yield anomaly score $S_t$ calibrated via streaming SPOT.}}{4}{figure.1}\protected@file@percent }
\newlabel{fig:triad_architecture}{{1}{4}{Operator-Entropy JEPA architecture: multiscale context ($\mathbf {x}_{\text {ctx}} \in \mathbb {R}^{256 \times K}$) and suspect ($\mathbf {x}_{\text {tgt}} \in \mathbb {R}^{64 \times K}$) windows are mapped into latent space via online ($E_\theta $) and EMA momentum ($E_\phi $) encoders with a stop-gradient barrier ($\perp $). A linear Koopman transition operator ($\mathbf {K} \in \mathbb {R}^{32 \times 32}$) forecasts the target representation $\hat {\mathbf {z}}_{\text {tgt}} = \mathbf {K}\mathbf {z}_{\text {ctx}}$, regularized by dual Von Neumann spectral entropy and a logarithmic Bregman energy barrier against collapse. Residual discrepancies pass through a coordinate saliency gate to yield anomaly score $S_t$ calibrated via streaming SPOT}{figure.1}{}}
